ARCHIV_HUB_PORT=8002
FLASK_ENV=production

# Sicherheit (MUSS für den Passwortschutz gesetzt werden)
# Geheimer Schlüssel für Flask-Sessions, z. B. erzeugen mit: openssl rand -hex 32
ARCHIV_HUB_SECRET_KEY=

# Passwort-Hash (mit generate-password-hash.py erzeugen, NICHT das Klartext-Passwort)
ARCHIV_HUB_PASSWORD_HASH=

# Optional: Session-Cookie nur über HTTPS senden (bei reiner HTTP-Nutzung 0 lassen)
ARCHIV_HUB_COOKIE_SECURE=0

# Ablage-Basis auf dem HOST = Speicherort "standard". Wird im Container als
# /ablage/standard eingebunden (lesen und schreiben). Der Pfad muss existieren;
# das Startskript legt ihn auf dem Mac an, falls er fehlt.
#   MacBook/OWC (Standard, Testordner):  ./data/ablage
#   Synology:  /volume1/archiv
# Weitere Speicherorte werden mit 66-archiv-hub-speicherort-hinzufuegen.command
# angelegt (compose.speicherorte.yaml + data/speicherorte.json, pro Maschine).
ARCHIV_HUB_ABLAGE_BASIS=./data/ablage

# DeepSeek (OpenAI-kompatibel). Der Key wird ausschliesslich hier bzw. in der
# lokalen .env gesetzt und niemals eingecheckt.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
